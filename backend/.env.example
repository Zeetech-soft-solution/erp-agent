# --- ERPNext connection (service-level, held only by the agent server) ---
ERPNEXT_BASE_URL=https://your-erpnext-site.example.com
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret

# --- Agent's own JWT ---
AGENT_JWT_SECRET=change_this_to_a_long_random_string
AGENT_JWT_EXPIRES_IN=8h

# --- Module plugin loader ---
# Add "entities" for config/entities.config.ts, "workflows" for config/workflows.config.ts, "reports" for config/reports.config.ts
ACTIVE_MODULES=crm,context,tickets,email,entities,workflows,reports

# --- LLM (OpenAI-compatible; swap provider via LLM_PROVIDER + a new class) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOOL_ITERATIONS=5

# --- Context budgets ---
CONTEXT_SESSION_TURNS=6
CONTEXT_VECTOR_TOPK=5
CONTEXT_BUDGET_CHARS=6000

# --- Postgres (pgvector + interaction_log) ---
DATABASE_URL=postgres://user:password@localhost:5432/erp_agent

PORT=4000
ADMIN_ROLES=System Manager

# Encrypts admin-provisioned user API credentials at rest (user_credentials
# table). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
SYSTEM_PROVIDER=erpnext
# SAP_BASE_URL=... (add SAP-specific vars here once sap/sapConnector.ts exists)
